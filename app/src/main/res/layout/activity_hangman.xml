<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2C1E68">

    <!-- Back, lives, run score, and the one-use hint match the source header. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="35dp">

        <ImageButton
            android:id="@+id/exitButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Exit game"
            android:padding="10dp"
            android:src="@drawable/left_arrow" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Lives"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hangman_heart" />

            <TextView
                android:id="@+id/livesText"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:fontFamily="@font/patrick_hand"
                android:gravity="center"
                android:text="5"
                android:textColor="#2C1E68"
                android:textSize="20sp"
                android:textStyle="bold" />

        </FrameLayout>

        <TextView
            android:id="@+id/wordCounterText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/nextel_white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/hintButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Use a hint"
            android:padding="5dp"
            android:src="@drawable/ic_hangman_hint" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6">

        <ImageView
            android:id="@+id/hangmanDrawing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|center_horizontal"
            android:contentDescription="Hangman drawing"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="35dp">

        <TextView
            android:id="@+id/hiddenWordText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/fira_mono"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="_____"
            android:textColor="@color/nextel_white"
            android:textSize="57sp"
            android:textStyle="normal" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp" />

</LinearLayout>
