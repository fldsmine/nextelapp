# Built development files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Gradle
proguard/

# Log files
*.log

# Android Studio local settings and caches
.navigation/
captures/
.externalNativeBuild/
.cxx/
cmake-build-*/
.m2/

# IntelliJ IDEA files (Android Studio is based on IntelliJ)
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.kotlin


# Keystore files (NEVER commit your signing keys!)
*.jks
*.keystore
*.p12

# Google Services configuration file (usually kept private)
# google-services.json

# OSX files
.DS_Store

# Explicitly ignore the app-level build and release artifacts
/app/build/
/app/release/

# Flutter-generated state and tool metadata
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/

# Windows files
Thumbs.db
